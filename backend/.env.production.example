NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-frontend-domain.example

# ForeSightX model forecast service
# PROJECT_ROOT is where forecast/anomaly artifacts live inside the container.
PROJECT_ROOT=/app
MODEL_FORECAST_ENABLED=true
MODEL_FORECAST_CITY=bangalore
# When true (default) future-row timestamps are re-anchored to the live server
# clock so the dashboard shows a rolling "now -> now + horizon" outlook.
MODEL_FORECAST_LIVE=true
# Hourly cadence of the trained model (matches the forecast CSV step).
MODEL_FORECAST_STEP_MINUTES=60

DB_HOST=postgres
DB_PORT=5432
DB_NAME=foresightx_db
DB_USER=foresightx_user
DB_PASSWORD=change_this_postgres_password
DB_SSL=false

POSTGRES_DB=foresightx_db
POSTGRES_USER=foresightx_user
POSTGRES_PASSWORD=change_this_postgres_password

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=foresightx:
REDIS_CONNECT_TIMEOUT_MS=5000

HTTP_TIMEOUT_MS=8000
HTTP_RETRIES=2
HTTP_RETRY_DELAY_MS=500

WAQI_BASE_URL=https://api.waqi.info
WAQI_API_KEY=replace_with_waqi_key

OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_API_KEY=replace_with_openweather_key
OPENWEATHER_UNITS=metric

GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_API_KEY=replace_with_google_maps_key
GOOGLE_ROUTES_FIELD_MASK=routes.duration,routes.staticDuration,routes.distanceMeters,routes.legs.duration,routes.legs.staticDuration,routes.legs.distanceMeters

SENDGRID_API_KEY=replace_with_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@foresightx.app
SENDGRID_FROM_NAME=ForeSightX

TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=

ADVISORY_CRON_ENABLED=true
ADVISORY_CRON_SCHEDULE=*/15 * * * *
ADVISORY_BATCH_SIZE=100
DEFAULT_TRAFFIC_DESTINATION_LAT=
DEFAULT_TRAFFIC_DESTINATION_LON=
DEFAULT_TRAFFIC_DESTINATION_ADDRESS=
